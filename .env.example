APP_NAME=Inventaris
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8082
# Alamat TETAP yang dicetak di stiker QR (IP tetap / nama domain kantor). Kosong = memakai APP_URL.
QR_URL=
COMPANY_NAME="PT Petrokopindo Cipta Selaras"

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventaris
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Nama cookie sesi sendiri, agar tidak bentrok dengan HaloDek di komputer yang sama.
SESSION_COOKIE=inventaris_session

# ===== Integrasi HaloDek =====
# Alamat HaloDek (dipakai tombol "Lapor kendala" dan QR stiker). Harus bisa dibuka dari HP karyawan.
HALODEK_URL=http://localhost:8081
# Token rahasia API (min. 16 karakter). Isi SAMA PERSIS di .env HaloDek (INVENTARIS_API_TOKEN).
# Buat dengan: php -r "echo bin2hex(random_bytes(24));"
INVENTARIS_API_TOKEN=

# Database HaloDek, hanya untuk memindahkan data lama: php artisan inventaris:impor-halodek
HALODEK_DB_DATABASE=halodek
